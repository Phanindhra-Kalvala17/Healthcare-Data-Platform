# Copy to .env and fill in. Never commit .env.

# Secret for keyed pseudonymization of patient IDs in the Gold zone (min 32 chars).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HDP_PSEUDONYMIZATION_KEY=

# Optional overrides
# HDP_DATA_DIR=./data
# HDP_QUALITY_THRESHOLD=0.85

# Local AWS emulator (MiniStack) only. Leave unset to use real AWS. See LOCAL_AWS.md.
# Never put real AWS keys in this file's committed example.
# AWS_ENDPOINT_URL=http://localhost:4566
