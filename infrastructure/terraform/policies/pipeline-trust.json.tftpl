{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueJobsInThisAccountAssumeRole",
      "Effect": "Allow",
      "Principal": { "Service": "glue.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "aws:SourceAccount": "${account_id}" } }
    }
  ]
}
